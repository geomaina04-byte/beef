# Copy this file to .env and fill in real values for local dev.
# Used by app/api/contact/route.ts to send contact-form submissions by email
# via the Resend HTTP API (https://resend.com) — chosen because it works on
# Cloudflare's edge runtime, unlike SMTP/nodemailer.
# If left unset, submissions are just logged server-side and the form still
# shows a success state — nothing breaks, email just won't send.

RESEND_API_KEY=your-resend-api-key

# Where contact-form submissions get delivered, and the verified "from"
# address/domain in your Resend account.
CONTACT_TO_EMAIL=beeftracekenya@gmail.com
CONTACT_FROM_EMAIL=contact@yourdomain.com
